print("QUESTION 2: HIDDEN MARKOV MODEL")
print("--------------------------------")
states = ["Sunny", "Cloudy", "Rainy"]
observations = ["Dry", "Humid", "Wet", "Wet", "Humid"]
start = {
    "Sunny": 0.5,
    "Cloudy": 0.3,
    "Rainy": 0.2
}
transition = {
    "Sunny": [0.6, 0.3, 0.1],
    "Cloudy": [0.2, 0.5, 0.3],
    "Rainy": [0.1, 0.3, 0.6]
}
emission = {
    "Sunny": [0.7, 0.2, 0.1],
    "Cloudy": [0.3, 0.4, 0.3],
    "Rainy": [0.1, 0.3, 0.6]
}
obs = [0, 1, 2, 2, 1]
result = []
for i in range(len(obs)):
    best = 0
    best_state = ""
    for j in range(3):
        if i == 0:
            p = start[states[j]] * emission[states[j]][obs[i]]
        else:
            p = transition[states[result[i - 1]]][j] * emission[states[j]][obs[i]]
        if p > best:
            best = p
            best_state = states[j]

    result.append(states.index(best_state))
print("Observations:", observations)
print("Predicted Hidden States:")
for i in result:
    print(states[i])
